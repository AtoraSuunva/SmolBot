model ApplicationEmoji {
  /**
   * The ID of the emoji
   */
  id     String @id
  /**
   * The name of the emoji
   */
  name   String @unique
  /**
   * The module the emoji belongs to
   */
  module String
  /**
   * The hash of the emoji (murmur3 hash) stored as hex because node murmurhash implementations don't return signed ints :/
   */
  hash   String

  @@index(module)
}
