model AutomodConfig {
  guildID         String  @id @map("guild_id")
  // Message to prepend to the automod trigger message
  prepend         String?
  // Channels to ignore
  ignoredChannels String  @default("")
  // Roles to ignore
  ignoredRoles    String  @default("")
  // Users to ignore
  ignoredUsers    String  @default("")
  // Whether to ignore bots
  ignoreBots      Boolean @default(true)
  // Whether to ignore users with admin permissions
  ignoreAdmins    Boolean @default(true)
}

model AutomodRule {
  ruleID     String   @id @map("rule_id")
  guildID    String   @map("guild_id")
  // Discriminator between rule types, bot-set
  type       String
  // Name shown to admins when viewing rules
  name       String
  // Message shown to users when rule is triggered
  message    String?
  // Action to take when rule is triggered, e.g. "timeout", "ban", "kick", "mute", "log"
  action     String   @default("log")
  // Duration of the action in seconds, if applicable (e.g. for timeout)
  duration   Int      @default(30)
  // Parameters the rule takes, as JSON
  /// [AutomodParameters]
  parameters Json     @default("\"{}\"")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([guildID, type])
}

model PhashInfo {
  // The "phash" of the image, using https://www.hackerfactor.com/blog/?/archives/432-Looks-Like-It.html
  phash     String
  // The guild this phash is associated with, or null if it's a global phash. Allows for a global "known images" list while letting guilds setup their own phashes
  guildID   String   @map("guild_id")
  // Whether this phash is associated with a scam image
  isScam    Boolean  @default(false) @map("is_scam")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([phash, guildID])
  @@index([phash])
}

model PhashUrl {
  // The URL of the image, which is associated with a phash
  url              String  @id
  // The phash this URL is associated with
  phash            String
  // The path to the file on disk, if the image was downloaded and stored for review
  filePath         String? @map("file_path")
  // Optional binary image payload for review and showing in /automod phash check
  imageData        Bytes?  @map("image_data")
  imageFileName    String? @map("image_file_name")
  imageContentType String? @map("image_content_type")
  imageSize        Int?    @map("image_size")

  createdAt DateTime @default(now()) @map("created_at")
}
