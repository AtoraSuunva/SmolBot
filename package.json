{
  "name": "smolbot",
  "version": "2.0.0",
  "description": "Custom mod/misc/util bot",
  "homepage": "https://github.com/AtoraSuunva/smolbot#readme",
  "bugs": {
    "url": "https://github.com/AtoraSuunva/smolbot/issues"
  },
  "license": "MIT",
  "author": "AtoraSuunva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtoraSuunva/smolbot.git"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "start:dev": "vp pack && node --env-file=.env --enable-source-maps --trace-warnings dist/index.mjs",
    "start:dist": "node --env-file=.env --enable-source-maps --trace-warnings dist/index.mjs",
    "start:prod": "prisma migrate deploy && node dist/index.mjs",
    "generate": "prisma generate",
    "build": "vp pack",
    "check": "vp check",
    "fix": "vp check --fix && prisma format",
    "prisma:fix": "prisma format",
    "sentry:sourcemaps:inject": "sentry-cli sourcemaps inject ./dist",
    "sentry:sourcemaps:upload": "sentry-cli sourcemaps upload ./dist",
    "prepare": "vp config"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.1",
    "@hono/node-server": "^2.0.12",
    "@plus99/murmur-hash": "^1.0.2",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/sqlcommenter-query-tags": "^7.9.1",
    "@sapphire/shapeshift": "^4.0.0",
    "better-sqlite3": "^13.0.2",
    "char-info": "^0.3.6",
    "chrono-node": "^2.10.1",
    "convert-units": "~2.3.4",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.1",
    "discord-api-types": "^0.38.52",
    "discord.js": "~14.27.0",
    "dotenv": "^17.4.2",
    "env-var": "~7.5.0",
    "function-timeout": "^1.0.2",
    "google-translate-api-x": "^10.7.3",
    "hono": "^4.12.32",
    "hono-rate-limiter": "^0.5.3",
    "luxon": "^3.7.2",
    "magic-bytes.js": "^1.13.1",
    "p-queue": "^9.3.3",
    "pino": "^10.3.1",
    "pino-dev": "^4.0.3",
    "pluralize": "^8.0.0",
    "pretty-ms": "~9.3.0",
    "prisma": "^7.9.1",
    "sharp": "^0.27.2",
    "sharp-phash": "^2.2.0",
    "sleetcord": "4.3.1",
    "sleetcord-common": "^16.0.3",
    "string-width": "^8.2.2",
    "ticket-queue": "^0.2.1",
    "tseep": "^1.3.1",
    "undici": "^8.9.0",
    "unicode-name": "^1.1.0"
  },
  "devDependencies": {
    "@sentry/cli": "^3.6.2",
    "@types/convert-units": "^2.3.12",
    "@types/luxon": "^3.7.2",
    "@types/node": "~26.1.2",
    "@types/pluralize": "^0.0.33",
    "prisma-json-types-generator": "^5.1.1",
    "typescript": "~7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.18.0"
}
