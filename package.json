{
  "name": "smolbot",
  "version": "2.0.0",
  "description": "Custom mod/misc/util bot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start:dev": "tsc --build && node --env-file=.env --enable-source-maps --trace-warnings dist/index.js",
    "start:dist": "node --env-file=.env --enable-source-maps --trace-warnings dist/index.js",
    "start:prod": "prisma migrate deploy && node --enable-source-maps dist/index.js",
    "generate": "prisma generate",
    "build": "tsc --build",
    "lint": "biome check && tsc --noEmit",
    "lint:fix": "biome check --write && prisma format && tsc --noEmit",
    "sentry:sourcemaps:inject": "sentry-cli sourcemaps inject ./dist",
    "sentry:sourcemaps:upload": "sentry-cli sourcemaps upload ./dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtoraSuunva/smolbot.git"
  },
  "author": "AtoraSuunva",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AtoraSuunva/smolbot/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "homepage": "https://github.com/AtoraSuunva/smolbot#readme",
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.1",
    "@hono/node-server": "^1.19.5",
    "@plus99/murmur-hash": "^1.0.2",
    "@prisma/adapter-better-sqlite3": "^6.16.3",
    "@prisma/client": "^6.16.3",
    "@sapphire/shapeshift": "^4.0.0",
    "better-sqlite3": "^12.4.1",
    "char-info": "^0.3.5",
    "convert-units": "~2.3.4",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "discord-api-types": "^0.38.26",
    "discord.js": "~14.22.1",
    "dotenv": "^17.2.3",
    "env-var": "~7.5.0",
    "google-translate-api-x": "^10.7.2",
    "hono": "^4.9.9",
    "hono-rate-limiter": "^0.4.2",
    "luxon": "^3.7.2",
    "magic-bytes.js": "^1.12.1",
    "p-queue": "^9.0.0",
    "parse-human-relative-time": "^4.0.0",
    "pino-dev": "^4.0.3",
    "pluralize": "^8.0.0",
    "pretty-ms": "~9.3.0",
    "sleetcord": "3.0.0",
    "sleetcord-common": "^15.0.1",
    "string-width": "^8.1.0",
    "super-regex": "^1.0.0",
    "ticket-queue": "^0.1.3",
    "tseep": "^1.3.1",
    "undici": "^7.16.0",
    "unicode-name": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@sentry/cli": "^2.56.0",
    "@types/convert-units": "^2.3.12",
    "@types/luxon": "^3.7.1",
    "@types/node": "~24.6.1",
    "@types/pluralize": "^0.0.33",
    "prisma": "^6.16.3",
    "typescript": "~5.9.3"
  }
}
