{
  "name": "smolbot",
  "version": "2.0.0",
  "description": "Custom mod/misc/util bot",
  "homepage": "https://github.com/AtoraSuunva/smolbot#readme",
  "bugs": {
    "url": "https://github.com/AtoraSuunva/smolbot/issues"
  },
  "license": "MIT",
  "author": "AtoraSuunva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtoraSuunva/smolbot.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start:dev": "tsgo --build && node --env-file=.env --enable-source-maps --trace-warnings dist/index.js",
    "start:dist": "node --env-file=.env --enable-source-maps --trace-warnings dist/index.js",
    "start:prod": "prisma migrate deploy && node --enable-source-maps dist/index.js",
    "generate": "prisma generate",
    "build": "tsgo --build",
    "check": "pnpm run '/check:.*/'",
    "fix": "pnpm run '/fix:.*/'",
    "check:lint": "oxlint",
    "check:format": "oxfmt --check",
    "fix:lint": "oxlint --fix",
    "fix:format": "oxfmt --write",
    "fix:prisma": "prisma format",
    "sentry:sourcemaps:inject": "sentry-cli sourcemaps inject ./dist",
    "sentry:sourcemaps:upload": "sentry-cli sourcemaps upload ./dist"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.1",
    "@hono/node-server": "^1.19.11",
    "@plus99/murmur-hash": "^1.0.2",
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@prisma/sqlcommenter-query-tags": "^7.5.0",
    "@sapphire/shapeshift": "^4.0.0",
    "better-sqlite3": "^12.8.0",
    "char-info": "^0.3.6",
    "chrono-node": "^2.9.0",
    "convert-units": "~2.3.4",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "discord-api-types": "^0.38.42",
    "discord.js": "~14.25.1",
    "dotenv": "^17.3.1",
    "env-var": "~7.5.0",
    "function-timeout": "^1.0.2",
    "google-translate-api-x": "^10.7.2",
    "hono": "^4.12.8",
    "hono-rate-limiter": "^0.5.3",
    "luxon": "^3.7.2",
    "magic-bytes.js": "^1.13.0",
    "p-queue": "^9.1.0",
    "pino": "^10.3.1",
    "pino-dev": "^4.0.3",
    "pluralize": "^8.0.0",
    "pretty-ms": "~9.3.0",
    "sleetcord": "3.0.0",
    "sleetcord-common": "^15.0.1",
    "string-width": "^8.2.0",
    "ticket-queue": "^0.2.1",
    "tseep": "^1.3.1",
    "undici": "^7.24.5",
    "unicode-name": "^1.1.0"
  },
  "devDependencies": {
    "@sentry/cli": "^3.3.3",
    "@types/convert-units": "^2.3.12",
    "@types/luxon": "^3.7.1",
    "@types/node": "~25.5.0",
    "@types/pluralize": "^0.0.33",
    "@typescript/native-preview": "7.0.0-dev.20260322.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "oxlint-tsgolint": "^0.17.1",
    "prisma": "^7.5.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
