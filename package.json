{
  "name": "smolbot",
  "version": "2.0.0",
  "description": "Custom mod/misc/util bot",
  "homepage": "https://github.com/AtoraSuunva/smolbot#readme",
  "bugs": {
    "url": "https://github.com/AtoraSuunva/smolbot/issues"
  },
  "license": "MIT",
  "author": "AtoraSuunva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AtoraSuunva/smolbot.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start:dev": "tsc --build && node --env-file=.env --enable-source-maps --trace-warnings dist/index.js",
    "start:dist": "node --env-file=.env --enable-source-maps --trace-warnings dist/index.js",
    "start:prod": "prisma migrate deploy && node --enable-source-maps dist/index.js",
    "generate": "prisma generate",
    "build": "tsc --build",
    "lint": "oxlint -c .oxlintrc.json src && oxfmt --config .oxfmtrc.json --check 'src/**/*.{ts,js}' && tsc --noEmit",
    "lint:fix": "oxfmt --config .oxfmtrc.json --write 'src/**/*.{ts,js}' && oxlint -c .oxlintrc.json src --fix && prisma format && tsc --noEmit",
    "sentry:sourcemaps:inject": "sentry-cli sourcemaps inject ./dist",
    "sentry:sourcemaps:upload": "sentry-cli sourcemaps upload ./dist"
  },
  "dependencies": {
    "@dice-roller/rpg-dice-roller": "^5.5.1",
    "@hono/node-server": "^1.19.9",
    "@plus99/murmur-hash": "^1.0.2",
    "@prisma/adapter-better-sqlite3": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@prisma/sqlcommenter-query-tags": "^7.4.2",
    "@sapphire/shapeshift": "^4.0.0",
    "better-sqlite3": "^12.6.2",
    "char-info": "^0.3.6",
    "chrono-node": "^2.9.0",
    "convert-units": "~2.3.4",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "discord-api-types": "^0.38.40",
    "discord.js": "~14.25.1",
    "dotenv": "^17.3.1",
    "env-var": "~7.5.0",
    "function-timeout": "^1.0.2",
    "google-translate-api-x": "^10.7.2",
    "hono": "^4.12.3",
    "hono-rate-limiter": "^0.5.3",
    "luxon": "^3.7.2",
    "magic-bytes.js": "^1.13.0",
    "p-queue": "^9.1.0",
    "pino": "^10.3.1",
    "pino-dev": "^4.0.3",
    "pluralize": "^8.0.0",
    "pretty-ms": "~9.3.0",
    "sleetcord": "3.0.0",
    "sleetcord-common": "^15.0.1",
    "string-width": "^8.2.0",
    "ticket-queue": "^0.2.1",
    "tseep": "^1.3.1",
    "undici": "^7.22.0",
    "unicode-name": "^1.1.0"
  },
  "devDependencies": {
    "@sentry/cli": "^3.2.2",
    "@types/convert-units": "^2.3.12",
    "@types/luxon": "^3.7.1",
    "@types/node": "~25.3.3",
    "@types/pluralize": "^0.0.33",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "prisma": "^7.4.2",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.30.1"
}
